<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="k8s_cluster_view_form" model="ir.ui.view">
        <field name="name">k8s.cluster.form</field>
        <field name="model">k8s.cluster</field>
        <field name="arch" type="xml">
            <form string="Kubernetes Cluster">
                <header>
                    <button name="action_test_connection" type="object" string="Probar Conexion"
                            class="oe_highlight" invisible="state == 'connected'"/>
                    <button name="action_test_connection" type="object" string="Verificar Conexion"
                            invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_instances" type="object" class="oe_stat_button" icon="fa-server">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="running_count"/>/<field name="instance_count"/>
                                </span>
                                <span class="o_stat_text">Instancias</span>
                            </div>
                        </button>
                        <button name="action_view_templates" type="object" class="oe_stat_button" icon="fa-file-code-o">
                            <span class="o_stat_text">Templates</span>
                        </button>
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Predeterminado" bg_color="text-bg-success"
                            invisible="not is_default"/>
                    <widget name="web_ribbon" title="Error" bg_color="text-bg-danger" invisible="state != 'error'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del Cluster"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identificacion">
                            <field name="code"/>
                            <field name="is_default"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Conexion">
                            <field name="connection_type"/>
                            <field name="default_namespace"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kubeconfig" name="kubeconfig" invisible="connection_type != 'kubeconfig'">
                            <field name="kubeconfig" widget="ace" options="{'mode': 'yaml'}"
                                   placeholder="Pegue aqui el contenido de su archivo kubeconfig..."/>
                        </page>
                        <page string="Conexion Directa" name="direct" invisible="connection_type != 'direct'">
                            <group>
                                <field name="api_server" placeholder="https://kubernetes.local:6443"/>
                                <field name="api_token" password="True"/>
                            </group>
                        </page>
                        <page string="PostgreSQL" name="database">
                            <group>
                                <group>
                                    <field name="db_host" placeholder="postgres.default.svc"/>
                                    <field name="db_port"/>
                                </group>
                                <group>
                                    <field name="db_admin_user"/>
                                    <field name="db_admin_password" password="True"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cloudflare" name="cloudflare">
                            <group>
                                <group>
                                    <field name="cloudflare_enabled"/>
                                    <field name="cloudflare_domain" placeholder="tudominio.com"
                                           invisible="not cloudflare_enabled"/>
                                    <field name="cloudflare_tunnel_token" password="True"
                                           invisible="not cloudflare_enabled"/>
                                </group>
                                <group invisible="not cloudflare_enabled">
                                    <field name="cloudflare_configmap_name"/>
                                    <field name="cloudflare_configmap_namespace"/>
                                    <field name="cloudflare_deployment_name"/>
                                </group>
                            </group>
                        </page>
                        <page string="Recursos Default" name="defaults">
                            <group>
                                <group>
                                    <field name="odoo_image"/>
                                    <field name="default_cpu_limit"/>
                                </group>
                                <group>
                                    <field name="default_memory_limit"/>
                                    <field name="default_storage_size"/>
                                </group>
                            </group>
                        </page>
                        <page string="Estado" name="status" invisible="state == 'draft'">
                            <group>
                                <field name="last_check"/>
                                <field name="connection_error" readonly="1" invisible="not connection_error"/>
                            </group>
                        </page>
                        <page string="Descripcion" name="description">
                            <field name="description" placeholder="Notas sobre este cluster..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="k8s_cluster_view_list" model="ir.ui.view">
        <field name="name">k8s.cluster.list</field>
        <field name="model">k8s.cluster</field>
        <field name="arch" type="xml">
            <list string="Clusters">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_default" widget="boolean"/>
                <field name="cloudflare_domain"/>
                <field name="running_count" string="Activas"/>
                <field name="instance_count" string="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
                <field name="last_check"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="k8s_cluster_view_search" model="ir.ui.view">
        <field name="name">k8s.cluster.search</field>
        <field name="model">k8s.cluster</field>
        <field name="arch" type="xml">
            <search string="Clusters">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Conectados" name="connected" domain="[('state', '=', 'connected')]"/>
                <filter string="Con Error" name="error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="k8s_cluster_action" model="ir.actions.act_window">
        <field name="name">Clusters</field>
        <field name="res_model">k8s.cluster</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="k8s_cluster_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurar tu primer cluster Kubernetes
            </p>
            <p>
                Conecta tu cluster para desplegar instancias Odoo automaticamente.
                Puedes tener multiples clusters (local, produccion, etc.)
            </p>
        </field>
    </record>

</odoo>
