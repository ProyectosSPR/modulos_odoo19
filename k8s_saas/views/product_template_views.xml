<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Product Template Form -->
    <record id="product_template_form_view_k8s" model="ir.ui.view">
        <field name="name">product.template.form.k8s</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Kubernetes SaaS" name="k8s_saas">
                    <group>
                        <group string="Configuracion K8s">
                            <field name="creates_k8s_instance"/>
                            <field name="k8s_plan_id" invisible="not creates_k8s_instance"
                                   options="{'no_create': True}"/>
                            <field name="k8s_managed_by_us" invisible="not creates_k8s_instance"/>
                        </group>
                        <group string="Descripcion" invisible="not creates_k8s_instance">
                            <div class="text-muted">
                                <p><strong>Crea Instancia K8s:</strong> Al confirmar una venta con este producto,
                                se creara automaticamente una instancia de Odoo en Kubernetes.</p>
                                <p><strong>Plan K8s:</strong> Define los recursos (CPU, memoria, almacenamiento)
                                que tendra la instancia.</p>
                                <p><strong>Administrado por Nosotros:</strong> Si esta activo, la instancia se
                                desplegara automaticamente. Si esta desactivado, solo se creara el registro
                                y el cliente debera instalar Odoo manualmente.</p>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
