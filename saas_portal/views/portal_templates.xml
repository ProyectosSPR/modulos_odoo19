<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Portal Home with SaaS Cards -->
    <template id="portal_my_home_saas" name="Portal SaaS Home" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div class="row mb-4">
                <!-- SaaS Dashboard Card -->
                <div class="col-lg-12">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h4 class="mb-1">Panel SaaS</h4>
                                    <p class="mb-0">Accede a tus suscripciones, instancias y servicios</p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a href="/my/saas" class="btn btn-light btn-lg">
                                        <i class="fa fa-dashboard"></i> Ver Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Add menu items to portal -->
    <template id="portal_my_home_menu_saas" name="Portal Menu SaaS" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'saas_dashboard'" class="breadcrumb-item active">Panel SaaS</li>
            <li t-if="page_name == 'subscriptions'" class="breadcrumb-item active">Suscripciones</li>
            <li t-if="page_name == 'subscription_detail'" class="breadcrumb-item">
                <a href="/my/subscriptions">Suscripciones</a>
            </li>
            <li t-if="page_name == 'subscription_detail'" class="breadcrumb-item active" t-esc="subscription.name"/>
            <li t-if="page_name == 'instances'" class="breadcrumb-item active">Mis Instancias</li>
            <li t-if="page_name == 'instance_detail'" class="breadcrumb-item">
                <a href="/my/instances">Mis Instancias</a>
            </li>
            <li t-if="page_name == 'instance_detail'" class="breadcrumb-item active" t-esc="instance.name"/>
        </xpath>
    </template>

    <!-- SaaS Dashboard - Enhanced -->
    <template id="portal_saas_dashboard" name="SaaS Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container-fluid py-4">
                <!-- Header with notifications -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Panel SaaS</h2>
                    <a href="/my/saas/notifications" class="btn btn-outline-secondary position-relative">
                        <i class="fa fa-bell"></i> Alertas
                        <t t-if="notifications">
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  t-esc="len([n for n in notifications if n['type'] in ('danger', 'warning')])"/>
                        </t>
                    </a>
                </div>

                <!-- Notifications Banner (if critical) -->
                <t t-foreach="notifications[:2]" t-as="notif">
                    <t t-if="notif['type'] == 'danger'">
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i t-attf-class="fa #{notif['icon']} me-2"></i>
                            <strong><t t-esc="notif['title']"/>:</strong>
                            <t t-esc="notif['message']"/>
                            <a t-att-href="notif['link']" class="alert-link ms-2">Ver detalles</a>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    </t>
                </t>

                <!-- Main Stats Row -->
                <div class="row g-3 mb-4">
                    <!-- K8s Instances Card -->
                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="text-muted mb-1">Instancias Odoo</p>
                                        <h3 class="mb-0">
                                            <span class="text-success" t-esc="k8s_metrics['running']"/>
                                            <small class="text-muted">/ <t t-esc="k8s_metrics['total']"/></small>
                                        </h3>
                                        <small class="text-muted">
                                            <span class="text-success"><i class="fa fa-circle"></i> Running</span>
                                            <t t-if="k8s_metrics['stopped'] > 0">
                                                <span class="ms-2 text-warning"><i class="fa fa-circle"></i> <t t-esc="k8s_metrics['stopped']"/> Stopped</span>
                                            </t>
                                        </small>
                                    </div>
                                    <div class="align-self-center">
                                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                            <i class="fa fa-server fa-2x text-success"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/instances" class="text-decoration-none">Ver instancias <i class="fa fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>

                    <!-- N8N Workflows Card -->
                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="text-muted mb-1">Workflows N8N</p>
                                        <h3 class="mb-0">
                                            <span class="text-primary" t-esc="n8n_summary['active']"/>
                                            <small class="text-muted">/ <t t-esc="n8n_summary['total']"/></small>
                                        </h3>
                                        <small>
                                            <span t-attf-class="#{n8n_summary['success_rate'] >= 90 and 'text-success' or n8n_summary['success_rate'] >= 70 and 'text-warning' or 'text-danger'}">
                                                <i class="fa fa-check-circle"></i> <t t-esc="n8n_summary['success_rate']"/>% exitosos
                                            </span>
                                        </small>
                                    </div>
                                    <div class="align-self-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                            <i class="fa fa-cogs fa-2x text-primary"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/n8n" class="text-decoration-none">Ver workflows <i class="fa fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>

                    <!-- Billing Card -->
                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="text-muted mb-1">Facturación Mensual</p>
                                        <h3 class="mb-0">
                                            <t t-esc="billing['monthly_recurring']" t-options="{'widget': 'monetary', 'display_currency': billing['currency']}"/>
                                        </h3>
                                        <small>
                                            <t t-if="billing['pending_count'] > 0">
                                                <span class="text-warning">
                                                    <i class="fa fa-exclamation-circle"></i>
                                                    <t t-esc="billing['pending_count']"/> facturas pendientes
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-success"><i class="fa fa-check"></i> Al día</span>
                                            </t>
                                        </small>
                                    </div>
                                    <div class="align-self-center">
                                        <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                            <i class="fa fa-credit-card fa-2x text-warning"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/invoices" class="text-decoration-none">Ver facturas <i class="fa fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>

                    <!-- Tasks/Projects Card -->
                    <div class="col-xl-3 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="text-muted mb-1">Proyectos / Tareas</p>
                                        <h3 class="mb-0">
                                            <span class="text-info" t-esc="len(projects)"/>
                                            <small class="text-muted">proyectos</small>
                                        </h3>
                                        <small>
                                            <span class="text-info">
                                                <i class="fa fa-tasks"></i> <t t-esc="tasks['open']"/> tareas abiertas
                                            </span>
                                        </small>
                                    </div>
                                    <div class="align-self-center">
                                        <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                            <i class="fa fa-folder-open fa-2x text-info"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0">
                                <a href="/my/projects" class="text-decoration-none">Ver proyectos <i class="fa fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resources Usage Row (K8s metrics) -->
                <t t-if="k8s_metrics['total'] > 0">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0"><i class="fa fa-tachometer me-2"></i>Recursos Asignados</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <div class="border-end">
                                        <h4 class="text-primary mb-0"><t t-esc="k8s_metrics['total_cpu']"/> cores</h4>
                                        <small class="text-muted">CPU Total</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border-end">
                                        <h4 class="text-success mb-0"><t t-esc="k8s_metrics['total_memory']"/> GB</h4>
                                        <small class="text-muted">Memoria RAM</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <h4 class="text-info mb-0"><t t-esc="k8s_metrics['total_storage']"/> GB</h4>
                                    <small class="text-muted">Almacenamiento</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="row">
                    <!-- Active Instances List -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fa fa-server me-2"></i>Mis Instancias</h5>
                                <a href="/my/instances" class="btn btn-sm btn-outline-primary">Ver todas</a>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="instances">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="instances[:5]" t-as="instance">
                                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong t-esc="instance.name"/>
                                                    <br/>
                                                    <small class="text-muted" t-esc="instance.url"/>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span t-attf-class="badge #{instance.state == 'running' and 'bg-success' or instance.state == 'stopped' and 'bg-warning' or 'bg-danger'} me-2">
                                                        <t t-if="instance.state == 'running'">Activa</t>
                                                        <t t-elif="instance.state == 'stopped'">Detenida</t>
                                                        <t t-else="" t-esc="instance.state"/>
                                                    </span>
                                                    <a t-if="instance.state == 'running' and instance.url"
                                                       t-attf-href="#{instance.url}" target="_blank"
                                                       class="btn btn-sm btn-primary">
                                                        <i class="fa fa-external-link"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-server fa-3x mb-3 text-secondary"></i>
                                        <p class="mb-0">No tienes instancias activas</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- N8N Workflows List -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fa fa-cogs me-2"></i>Workflows N8N</h5>
                                <a href="/my/n8n" class="btn btn-sm btn-outline-primary">Ver todos</a>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="n8n_summary['workflows']">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="n8n_summary['workflows'][:5]" t-as="wf">
                                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong t-esc="wf.custom_name or wf.product_id.name"/>
                                                    <br/>
                                                    <small class="text-muted">
                                                        <t t-esc="wf.total_executions"/> ejecuciones
                                                        <t t-if="wf.last_execution_date">
                                                            - Última: <t t-esc="wf.last_execution_date" t-options="{'widget': 'datetime', 'format': 'dd/MM HH:mm'}"/>
                                                        </t>
                                                    </small>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span t-attf-class="badge #{wf.is_active and 'bg-success' or 'bg-secondary'} me-2">
                                                        <t t-if="wf.is_active">Activo</t>
                                                        <t t-else="">Inactivo</t>
                                                    </span>
                                                    <a t-attf-href="/my/n8n/#{wf.id}" class="btn btn-sm btn-outline-secondary">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-cogs fa-3x mb-3 text-secondary"></i>
                                        <p class="mb-0">No tienes workflows configurados</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Upcoming Appointments -->
                    <div class="col-lg-4 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fa fa-calendar me-2"></i>Próximas Citas</h5>
                                <a href="/appointment" class="btn btn-sm btn-success">+ Agendar</a>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="appointments">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="appointments" t-as="apt">
                                            <div class="list-group-item">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong t-esc="apt.name"/>
                                                    </div>
                                                    <span class="badge bg-info">
                                                        <t t-esc="apt.start" t-options="{'widget': 'datetime', 'format': 'dd MMM HH:mm'}"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-calendar-o fa-2x mb-2 text-secondary"></i>
                                        <p class="mb-2">Sin citas programadas</p>
                                        <a href="/appointment" class="btn btn-primary btn-sm">Agendar Ahora</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Billing Summary -->
                    <div class="col-lg-4 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent">
                                <h5 class="mb-0"><i class="fa fa-money me-2"></i>Resumen Facturación</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Suscripciones activas</span>
                                        <strong t-esc="billing['active_subscriptions']"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Recurrente mensual</span>
                                        <strong>
                                            <t t-esc="billing['monthly_recurring']" t-options="{'widget': 'monetary', 'display_currency': billing['currency']}"/>
                                        </strong>
                                    </div>
                                </div>
                                <hr/>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Pagado este mes</span>
                                        <span class="text-success">
                                            <t t-esc="billing['paid_this_month']" t-options="{'widget': 'monetary', 'display_currency': billing['currency']}"/>
                                        </span>
                                    </div>
                                </div>
                                <t t-if="billing['pending_amount'] > 0">
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">Pendiente de pago</span>
                                            <span class="text-danger fw-bold">
                                                <t t-esc="billing['pending_amount']" t-options="{'widget': 'monetary', 'display_currency': billing['currency']}"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="billing['next_payment_date']">
                                    <div class="alert alert-info py-2 mb-0">
                                        <small><i class="fa fa-calendar me-1"></i>Próximo cobro: <strong t-esc="billing['next_payment_date']"/></small>
                                    </div>
                                </t>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/my/invoices" class="btn btn-outline-primary btn-sm w-100">Ver Facturas</a>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Notifications -->
                    <div class="col-lg-4 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fa fa-bell me-2"></i>Notificaciones</h5>
                                <a href="/my/saas/notifications" class="btn btn-sm btn-outline-secondary">Ver todas</a>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="notifications">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="notifications[:5]" t-as="notif">
                                            <a t-att-href="notif['link']" class="list-group-item list-group-item-action">
                                                <div class="d-flex align-items-center">
                                                    <div t-attf-class="rounded-circle p-2 me-3 bg-#{notif['type']} bg-opacity-10">
                                                        <i t-attf-class="fa #{notif['icon']} text-#{notif['type']}"></i>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex justify-content-between">
                                                            <strong class="small" t-esc="notif['title']"/>
                                                        </div>
                                                        <small class="text-muted" t-esc="notif['message']"/>
                                                    </div>
                                                </div>
                                            </a>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-check-circle fa-2x mb-2 text-success"></i>
                                        <p class="mb-0">Todo en orden</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Subscriptions Table -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fa fa-refresh me-2"></i>Mis Suscripciones</h5>
                        <a href="/my/subscriptions" class="btn btn-sm btn-outline-primary">Ver todas</a>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="subscriptions">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Suscripción</th>
                                            <th>Plan</th>
                                            <th>Estado</th>
                                            <th>Próximo Cobro</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="subscriptions[:5]" t-as="sub">
                                            <tr>
                                                <td>
                                                    <a t-attf-href="/my/subscription/#{sub.id}" class="fw-bold text-decoration-none">
                                                        <t t-esc="sub.name"/>
                                                    </a>
                                                </td>
                                                <td>
                                                    <t t-foreach="sub.order_line[:2]" t-as="line">
                                                        <span class="badge bg-light text-dark" t-esc="line.product_id.name"/>
                                                    </t>
                                                </td>
                                                <td>
                                                    <span t-attf-class="badge #{sub.subscription_state == '3_progress' and 'bg-success' or 'bg-warning'}">
                                                        <t t-if="sub.subscription_state == '3_progress'">Activa</t>
                                                        <t t-elif="sub.subscription_state == '4_paused'">Pausada</t>
                                                        <t t-else="" t-esc="sub.subscription_state"/>
                                                    </span>
                                                </td>
                                                <td t-esc="sub.next_invoice_date"/>
                                                <td class="text-end">
                                                    <a t-attf-href="/my/subscription/#{sub.id}" class="btn btn-sm btn-outline-secondary">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center text-muted py-5">
                                <i class="fa fa-refresh fa-3x mb-3 text-secondary"></i>
                                <p class="mb-0">No tienes suscripciones activas</p>
                            </div>
                        </t>
                    </div>
                </div>

            </div>
        </t>
    </template>

    <!-- Notifications Page -->
    <template id="portal_saas_notifications" name="SaaS Notifications">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Alertas y Notificaciones</h2>
                    <a href="/my/saas" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"></i> Volver al Dashboard
                    </a>
                </div>

                <t t-if="notifications">
                    <div class="list-group">
                        <t t-foreach="notifications" t-as="notif">
                            <a t-att-href="notif['link']" t-attf-class="list-group-item list-group-item-action list-group-item-#{notif['type']}">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <i t-attf-class="fa #{notif['icon']} fa-2x"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="mb-1" t-esc="notif['title']"/>
                                            <small t-if="notif['date']">
                                                <t t-esc="notif['date']" t-options="{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm'}"/>
                                            </small>
                                        </div>
                                        <p class="mb-0" t-esc="notif['message']"/>
                                    </div>
                                    <div class="ms-3">
                                        <i class="fa fa-chevron-right"></i>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center py-5">
                        <i class="fa fa-check-circle fa-4x text-success mb-3"></i>
                        <h4>Todo en orden</h4>
                        <p class="text-muted">No tienes notificaciones pendientes</p>
                        <a href="/my/saas" class="btn btn-primary">Ir al Dashboard</a>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
