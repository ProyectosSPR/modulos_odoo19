<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Portal Home with SaaS Cards -->
    <template id="portal_my_home_saas" name="Portal SaaS Home" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div class="row mb-4">
                <!-- SaaS Dashboard Card -->
                <div class="col-lg-12">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h4 class="mb-1">Panel SaaS</h4>
                                    <p class="mb-0">Accede a tus suscripciones, instancias y servicios</p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a href="/my/saas" class="btn btn-light btn-lg">
                                        <i class="fa fa-dashboard"></i> Ver Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Add menu items to portal -->
    <template id="portal_my_home_menu_saas" name="Portal Menu SaaS" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'saas_dashboard'" class="breadcrumb-item active">Panel SaaS</li>
            <li t-if="page_name == 'subscriptions'" class="breadcrumb-item active">Suscripciones</li>
            <li t-if="page_name == 'subscription_detail'" class="breadcrumb-item">
                <a href="/my/subscriptions">Suscripciones</a>
            </li>
            <li t-if="page_name == 'subscription_detail'" class="breadcrumb-item active" t-esc="subscription.name"/>
            <li t-if="page_name == 'instances'" class="breadcrumb-item active">Mis Instancias</li>
            <li t-if="page_name == 'instance_detail'" class="breadcrumb-item">
                <a href="/my/instances">Mis Instancias</a>
            </li>
            <li t-if="page_name == 'instance_detail'" class="breadcrumb-item active" t-esc="instance.name"/>
        </xpath>
    </template>

    <!-- SaaS Dashboard -->
    <template id="portal_saas_dashboard" name="SaaS Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4">
                <h2 class="mb-4">Panel SaaS</h2>

                <!-- Stats Cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h3 class="text-primary" t-esc="len(subscriptions)"/>
                                <p class="text-muted mb-0">Suscripciones Activas</p>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/my/subscriptions" class="stretched-link">Ver todas</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h3 class="text-success" t-esc="len(instances)"/>
                                <p class="text-muted mb-0">Instancias Odoo</p>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/my/instances" class="stretched-link">Ver todas</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h3 class="text-info" t-esc="len(appointments)"/>
                                <p class="text-muted mb-0">Próximas Citas</p>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/my/appointments" class="stretched-link">Ver todas</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h3 class="text-warning" t-esc="len(projects)"/>
                                <p class="text-muted mb-0">Proyectos Activos</p>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/my/projects" class="stretched-link">Ver todos</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Active Instances -->
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Mis Instancias Odoo</h5>
                                <a href="/my/instances" class="btn btn-sm btn-outline-primary">Ver todas</a>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="instances">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="instances[:5]" t-as="instance">
                                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong t-esc="instance.name"/>
                                                    <br/>
                                                    <small class="text-muted" t-esc="instance.url"/>
                                                </div>
                                                <div>
                                                    <span t-attf-class="badge #{instance.state == 'running' and 'bg-success' or 'bg-warning'}">
                                                        <t t-esc="instance.state"/>
                                                    </span>
                                                    <a t-if="instance.state == 'running' and instance.url"
                                                       t-attf-href="#{instance.url}" target="_blank"
                                                       class="btn btn-sm btn-primary ms-2">
                                                        <i class="fa fa-external-link"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-server fa-3x mb-3"></i>
                                        <p>No tienes instancias activas</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Upcoming Appointments -->
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Próximas Citas</h5>
                                <a href="/appointment" class="btn btn-sm btn-outline-primary">Agendar Cita</a>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="appointments">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="appointments" t-as="apt">
                                            <div class="list-group-item">
                                                <div class="d-flex justify-content-between">
                                                    <strong t-esc="apt.name"/>
                                                    <span class="badge bg-info">
                                                        <t t-esc="apt.start" t-options="{'widget': 'datetime', 'format': 'dd MMM HH:mm'}"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-calendar fa-3x mb-3"></i>
                                        <p>No tienes citas programadas</p>
                                        <a href="/appointment" class="btn btn-primary">Agendar Ahora</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Subscriptions -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Mis Suscripciones</h5>
                        <a href="/my/subscriptions" class="btn btn-sm btn-outline-primary">Ver todas</a>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="subscriptions">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Suscripción</th>
                                        <th>Plan</th>
                                        <th>Estado</th>
                                        <th>Próximo Cobro</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="subscriptions[:5]" t-as="sub">
                                        <tr>
                                            <td><a t-attf-href="/my/subscription/#{sub.id}" t-esc="sub.name"/></td>
                                            <td>
                                                <t t-foreach="sub.order_line[:2]" t-as="line">
                                                    <span t-esc="line.product_id.name"/><br/>
                                                </t>
                                            </td>
                                            <td>
                                                <span t-attf-class="badge #{sub.subscription_state == '3_progress' and 'bg-success' or 'bg-warning'}">
                                                    <t t-if="sub.subscription_state == '3_progress'">Activa</t>
                                                    <t t-elif="sub.subscription_state == '4_paused'">Pausada</t>
                                                    <t t-else="" t-esc="sub.subscription_state"/>
                                                </span>
                                            </td>
                                            <td t-esc="sub.next_invoice_date"/>
                                            <td class="text-end">
                                                <a t-attf-href="/my/subscription/#{sub.id}" class="btn btn-sm btn-outline-secondary">
                                                    Detalles
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="text-center text-muted py-4">
                                <i class="fa fa-refresh fa-3x mb-3"></i>
                                <p>No tienes suscripciones activas</p>
                            </div>
                        </t>
                    </div>
                </div>

            </div>
        </t>
    </template>

</odoo>
