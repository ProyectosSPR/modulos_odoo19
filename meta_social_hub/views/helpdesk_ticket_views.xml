<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Helpdesk Ticket Form View -->
    <record id="helpdesk_ticket_view_form_inherit_meta" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.meta.social.hub</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Add button to open conversation -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_meta_conversation" type="object"
                        class="oe_stat_button" icon="fa-comments"
                        invisible="not meta_conversation_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Conversation</span>
                    </div>
                </button>
            </xpath>

            <!-- Add reply via Meta button -->
            <xpath expr="//header" position="inside">
                <button name="action_reply_via_meta" type="object"
                        string="Reply via Chat" icon="fa-reply"
                        class="btn-secondary"
                        invisible="not meta_conversation_id"
                        groups="meta_social_hub.group_meta_social_user"/>
            </xpath>

            <!-- Add Meta fields -->
            <xpath expr="//group[@name='ticket_info']" position="inside">
                <field name="meta_conversation_id" readonly="1" groups="meta_social_hub.group_meta_social_user"/>
                <field name="meta_channel_type" readonly="1" widget="badge" invisible="not meta_conversation_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add to Ticket List View -->
    <record id="helpdesk_ticket_view_list_inherit_meta" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.inherit.meta.social.hub</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="meta_channel_type" widget="badge" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add filter to search -->
    <record id="helpdesk_ticket_view_search_inherit_meta" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.inherit.meta.social.hub</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="From Meta Channels" name="from_meta"
                        domain="[('meta_conversation_id', '!=', False)]"/>
                <filter string="From WhatsApp" name="from_whatsapp"
                        domain="[('meta_channel_type', '=', 'whatsapp')]"/>
            </xpath>
        </field>
    </record>
</odoo>
