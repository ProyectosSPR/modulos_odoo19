<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Meta Message Tree View -->
    <record id="meta_message_view_list" model="ir.ui.view">
        <field name="name">meta.message.list</field>
        <field name="model">meta.message</field>
        <field name="arch" type="xml">
            <list string="Messages" default_order="create_date desc" decoration-info="message_type == 'inbound'" decoration-success="message_type == 'outbound'" decoration-muted="state == 'failed'">
                <field name="create_date" string="Date"/>
                <field name="conversation_id"/>
                <field name="channel_type" widget="badge"/>
                <field name="message_type" widget="badge" decoration-info="message_type == 'inbound'" decoration-success="message_type == 'outbound'"/>
                <field name="body_text" string="Message"/>
                <field name="state" widget="badge" decoration-success="state in ['sent', 'delivered', 'read']" decoration-warning="state == 'outgoing'" decoration-danger="state == 'failed'"/>
                <field name="author_user_id" optional="show"/>
                <field name="attachment_count" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Meta Message Form View -->
    <record id="meta_message_view_form" model="ir.ui.view">
        <field name="name">meta.message.form</field>
        <field name="model">meta.message</field>
        <field name="arch" type="xml">
            <form string="Message">
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_retry_send" type="object" string="Retry" class="btn-warning" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,outgoing,sent,delivered,read"/>
                </header>
                <sheet>
                    <group>
                        <group string="Message">
                            <field name="conversation_id"/>
                            <field name="channel_type" readonly="1"/>
                            <field name="message_type" readonly="1"/>
                        </group>
                        <group string="Status">
                            <field name="state" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="delivered_date" readonly="1"/>
                            <field name="read_date" readonly="1"/>
                            <field name="failure_reason" readonly="1" invisible="state != 'failed'"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="body" widget="html" colspan="2"/>
                        <field name="attachment_ids" widget="many2many_binary" colspan="2"/>
                    </group>
                    <group string="Products" invisible="not product_ids">
                        <field name="product_ids" widget="many2many_tags" colspan="2"/>
                    </group>
                    <group string="Technical" groups="base.group_no_one">
                        <field name="external_id" readonly="1"/>
                        <field name="mail_message_id" readonly="1"/>
                        <field name="whatsapp_message_id" readonly="1"/>
                        <field name="reply_to_id" readonly="1"/>
                        <field name="author_partner_id" readonly="1"/>
                        <field name="author_user_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="meta_message_view_search" model="ir.ui.view">
        <field name="name">meta.message.search</field>
        <field name="model">meta.message</field>
        <field name="arch" type="xml">
            <search string="Messages">
                <field name="body_text"/>
                <field name="conversation_id"/>
                <field name="external_id"/>
                <separator/>
                <filter string="Received" name="filter_inbound" domain="[('message_type', '=', 'inbound')]"/>
                <filter string="Sent" name="filter_outbound" domain="[('message_type', '=', 'outbound')]"/>
                <separator/>
                <filter string="Pending" name="filter_pending" domain="[('state', 'in', ['draft', 'outgoing'])]"/>
                <filter string="Failed" name="filter_failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="Today" name="filter_today" domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Conversation" name="group_conversation" context="{'group_by': 'conversation_id'}"/>
                    <filter string="Channel Type" name="group_channel_type" context="{'group_by': 'channel_type'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'message_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_meta_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">meta.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="meta_message_view_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
