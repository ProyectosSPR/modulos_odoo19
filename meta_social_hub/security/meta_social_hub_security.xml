<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="module_category_meta_social" model="ir.module.category">
        <field name="name">Meta Social Hub</field>
        <field name="description">Category for Meta Social Hub access rights</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_meta_social_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_meta_social"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and respond to conversations assigned to them</field>
    </record>

    <record id="group_meta_social_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_meta_social"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_social_user'))]"/>
        <field name="comment">Can manage all conversations, channels and settings</field>
    </record>

    <record id="group_meta_social_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_meta_social"/>
        <field name="implied_ids" eval="[(4, ref('group_meta_social_manager'))]"/>
        <field name="comment">Full access including configuration and API settings</field>
    </record>

    <!-- Record Rules -->

    <!-- Conversations: Users see only assigned or unassigned -->
    <record id="meta_conversation_rule_user" model="ir.rule">
        <field name="name">Meta Conversation: User sees assigned or unassigned</field>
        <field name="model_id" ref="model_meta_conversation"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('user_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('group_meta_social_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Conversations: Managers see all -->
    <record id="meta_conversation_rule_manager" model="ir.rule">
        <field name="name">Meta Conversation: Manager sees all</field>
        <field name="model_id" ref="model_meta_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meta_social_manager'))]"/>
    </record>

    <!-- Messages: Follow conversation visibility -->
    <record id="meta_message_rule_user" model="ir.rule">
        <field name="name">Meta Message: User sees messages from visible conversations</field>
        <field name="model_id" ref="model_meta_message"/>
        <field name="domain_force">[
            '|',
            ('conversation_id.user_id', '=', user.id),
            ('conversation_id.user_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('group_meta_social_user'))]"/>
    </record>

    <record id="meta_message_rule_manager" model="ir.rule">
        <field name="name">Meta Message: Manager sees all</field>
        <field name="model_id" ref="model_meta_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meta_social_manager'))]"/>
    </record>

    <!-- Channels: All users can read, only managers can modify -->
    <record id="meta_channel_rule_user_read" model="ir.rule">
        <field name="name">Meta Channel: Users can read all</field>
        <field name="model_id" ref="model_meta_channel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meta_social_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="meta_channel_rule_manager" model="ir.rule">
        <field name="name">Meta Channel: Manager full access</field>
        <field name="model_id" ref="model_meta_channel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_meta_social_manager'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="meta_channel_company_rule" model="ir.rule">
        <field name="name">Meta Channel: Multi-company</field>
        <field name="model_id" ref="model_meta_channel"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="meta_conversation_company_rule" model="ir.rule">
        <field name="name">Meta Conversation: Multi-company</field>
        <field name="model_id" ref="model_meta_conversation"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>
</odoo>
