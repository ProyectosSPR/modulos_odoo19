<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="saas_skill_view_form" model="ir.ui.view">
        <field name="name">saas.skill.form</field>
        <field name="model">saas.skill</field>
        <field name="arch" type="xml">
            <form string="Habilidad">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_collaborators" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="collaborator_count" widget="statinfo" string="Colaboradores"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Productos que Requieren este Skill">
                        <field name="product_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="list_price"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="saas_skill_view_list" model="ir.ui.view">
        <field name="name">saas.skill.list</field>
        <field name="model">saas.skill</field>
        <field name="arch" type="xml">
            <list string="Habilidades" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="color" widget="color_picker"/>
                <field name="collaborator_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="saas_skill_view_kanban" model="ir.ui.view">
        <field name="name">saas.skill.kanban</field>
        <field name="model">saas.skill</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="color"/>
                <field name="collaborator_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                            <field class="fw-bold" name="name"/>
                            <div class="text-muted">
                                <field name="collaborator_count"/> colaboradores
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="saas_skill_view_search" model="ir.ui.view">
        <field name="name">saas.skill.search</field>
        <field name="model">saas.skill</field>
        <field name="arch" type="xml">
            <search string="Habilidades">
                <field name="name"/>
                <field name="category"/>
                <separator/>
                <filter string="Archivados" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Categoría" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="saas_skill_action" model="ir.actions.act_window">
        <field name="name">Habilidades</field>
        <field name="res_model">saas.skill</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="saas_skill_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una habilidad
            </p>
            <p>
                Define las habilidades y especialidades que pueden tener los colaboradores.
            </p>
        </field>
    </record>

</odoo>
