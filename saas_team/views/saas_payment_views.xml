<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="saas_payment_view_form" model="ir.ui.view">
        <field name="name">saas.collaborator.payment.form</field>
        <field name="model">saas.collaborator.payment</field>
        <field name="arch" type="xml">
            <form string="Pago a Colaborador">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_pay" type="object" string="Marcar Pagado"
                            invisible="state not in ('draft', 'pending')" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'pending')"/>
                    <button name="action_draft" type="object" string="Regresar a Borrador"
                            invisible="state not in ('pending', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información del Pago">
                            <field name="collaborator_id"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="payment_method"/>
                        </group>
                        <group string="Balance">
                            <field name="balance_before"/>
                            <field name="balance_after"/>
                        </group>
                    </group>
                    <group>
                        <group string="Periodo">
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Desglose">
                            <field name="hours_paid"/>
                            <field name="rate_applied"/>
                        </group>
                    </group>
                    <group>
                        <group string="Referencias">
                            <field name="payment_reference"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Comprobantes">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="saas_payment_view_list" model="ir.ui.view">
        <field name="name">saas.collaborator.payment.list</field>
        <field name="model">saas.collaborator.payment</field>
        <field name="arch" type="xml">
            <list string="Pagos" decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="name"/>
                <field name="collaborator_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="payment_method"/>
                <field name="payment_reference"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'cancelled'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="saas_payment_view_search" model="ir.ui.view">
        <field name="name">saas.collaborator.payment.search</field>
        <field name="model">saas.collaborator.payment</field>
        <field name="arch" type="xml">
            <search string="Pagos">
                <field name="name"/>
                <field name="collaborator_id"/>
                <field name="payment_reference"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pendientes" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Pagados" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Cancelados" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Este Mes" name="this_month"
                        domain="[('date', '>=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mes Pasado" name="last_month"
                        domain="[('date', '>=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter string="Colaborador" name="group_collaborator" context="{'group_by': 'collaborator_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Método de Pago" name="group_method" context="{'group_by': 'payment_method'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="saas_payment_action" model="ir.actions.act_window">
        <field name="name">Pagos a Colaboradores</field>
        <field name="res_model">saas.collaborator.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="saas_payment_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay pagos pendientes
            </p>
            <p>
                Los pagos se crean desde la ficha del colaborador.
            </p>
        </field>
    </record>

    <!-- Pending Payments Action -->
    <record id="saas_payment_pending_action" model="ir.actions.act_window">
        <field name="name">Pagos Pendientes</field>
        <field name="res_model">saas.collaborator.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('draft', 'pending'))]</field>
    </record>

</odoo>
