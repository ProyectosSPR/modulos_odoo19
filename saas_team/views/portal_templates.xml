<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal: Mis Proyectos para Colaborador -->
    <template id="portal_my_collaborator_projects" name="Mis Proyectos (Colaborador)">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mis Proyectos</t>
            </t>

            <t t-if="not projects">
                <div class="alert alert-info" role="alert">
                    No tienes proyectos asignados actualmente.
                </div>
            </t>

            <t t-if="projects">
                <div class="row">
                    <t t-foreach="projects" t-as="project">
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-attf-href="/my/project/#{project.id}">
                                            <t t-esc="project.name"/>
                                        </a>
                                    </h5>
                                    <p class="card-text text-muted">
                                        <t t-esc="project.partner_id.name"/>
                                    </p>
                                    <div class="d-flex justify-content-between">
                                        <span class="badge bg-primary">
                                            <t t-esc="project.task_count"/> tareas
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- Portal: Mi Balance de Colaborador -->
    <template id="portal_my_collaborator_balance" name="Mi Balance">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="card mb-4">
                <div class="card-header">
                    <h4>Mi Balance</h4>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <h5 class="text-muted">Total Ganado</h5>
                            <h2 class="text-success">
                                <t t-esc="collaborator.total_earned" t-options="{'widget': 'monetary', 'display_currency': collaborator.currency_id}"/>
                            </h2>
                        </div>
                        <div class="col-md-4">
                            <h5 class="text-muted">Total Pagado</h5>
                            <h2>
                                <t t-esc="collaborator.total_paid" t-options="{'widget': 'monetary', 'display_currency': collaborator.currency_id}"/>
                            </h2>
                        </div>
                        <div class="col-md-4">
                            <h5 class="text-muted">Saldo Pendiente</h5>
                            <h2 t-attf-class="#{collaborator.balance > 0 and 'text-primary' or ''}">
                                <t t-esc="collaborator.balance" t-options="{'widget': 'monetary', 'display_currency': collaborator.currency_id}"/>
                            </h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Estadísticas</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            <h6 class="text-muted">Horas Esta Semana</h6>
                            <h3><t t-esc="'%.2f' % collaborator.hours_this_week"/> hrs</h3>
                        </div>
                        <div class="col-md-3 text-center">
                            <h6 class="text-muted">Horas Disponibles</h6>
                            <h3><t t-esc="'%.2f' % collaborator.hours_per_week"/> hrs</h3>
                        </div>
                        <div class="col-md-3 text-center">
                            <h6 class="text-muted">Horas Totales</h6>
                            <h3><t t-esc="'%.2f' % collaborator.hours_worked"/> hrs</h3>
                        </div>
                        <div class="col-md-3 text-center">
                            <h6 class="text-muted">Tarifa</h6>
                            <h3>
                                <t t-esc="collaborator.rate_amount" t-options="{'widget': 'monetary', 'display_currency': collaborator.currency_id}"/>
                                <small class="text-muted">/hr</small>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Historial de Pagos</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Referencia</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="payments" t-as="payment">
                                <tr>
                                    <td><t t-esc="payment.date"/></td>
                                    <td><t t-esc="payment.name"/></td>
                                    <td>
                                        <t t-esc="payment.amount" t-options="{'widget': 'monetary', 'display_currency': payment.currency_id}"/>
                                    </td>
                                    <td><t t-esc="dict(payment._fields['payment_method'].selection).get(payment.payment_method, '')"/></td>
                                    <td>
                                        <span t-attf-class="badge #{payment.state == 'paid' and 'bg-success' or payment.state == 'pending' and 'bg-warning' or 'bg-secondary'}">
                                            <t t-esc="dict(payment._fields['state'].selection).get(payment.state, '')"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="not payments">
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No hay pagos registrados
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!-- Add to portal home -->
    <template id="portal_my_home_collaborator" name="Portal Colaborador" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-if="collaborator">
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card bg-light">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5 class="mb-1">Bienvenido, <t t-esc="collaborator.name"/></h5>
                                        <p class="mb-0 text-muted">
                                            <t t-esc="collaborator.skill_ids.mapped('name')" t-options="{'widget': 'list'}"/>
                                        </p>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <a href="/my/collaborator/balance" class="btn btn-primary">
                                            Saldo: <t t-esc="collaborator.balance" t-options="{'widget': 'monetary', 'display_currency': collaborator.currency_id}"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Collaborator Application Form (Public) -->
    <template id="collaborator_apply_form" name="Formulario de Aplicación">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h3 class="mb-0">Únete a Nuestro Equipo</h3>
                            </div>
                            <div class="card-body">
                                <form action="/collaborator/apply/submit" method="POST" enctype="multipart/form-data" class="s_website_form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Nombre Completo *</label>
                                            <input type="text" name="name" class="form-control" required="required"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Email *</label>
                                            <input type="email" name="email" class="form-control" required="required"/>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Teléfono</label>
                                            <input type="tel" name="phone" class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">LinkedIn / Portfolio</label>
                                            <input type="url" name="linkedin" class="form-control"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Habilidades *</label>
                                        <div class="row">
                                            <t t-foreach="skills" t-as="skill">
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox"
                                                               name="skill_ids" t-att-value="skill.id" t-att-id="'skill_%s' % skill.id"/>
                                                        <label class="form-check-label" t-att-for="'skill_%s' % skill.id">
                                                            <t t-esc="skill.name"/>
                                                        </label>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Nivel de Experiencia *</label>
                                            <select name="skill_level" class="form-select" required="required">
                                                <option value="junior">Junior (0-2 años)</option>
                                                <option value="mid" selected="selected">Mid-Level (2-5 años)</option>
                                                <option value="senior">Senior (5-10 años)</option>
                                                <option value="expert">Experto (+10 años)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Disponibilidad *</label>
                                            <select name="availability" class="form-select" required="required">
                                                <option value="full">Tiempo Completo</option>
                                                <option value="part">Medio Tiempo</option>
                                                <option value="project">Por Proyecto</option>
                                                <option value="hours" selected="selected">Por Horas</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Tarifa por Hora (USD)</label>
                                            <input type="number" name="rate_amount" class="form-control" step="0.01"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Horas Disponibles por Semana</label>
                                            <input type="number" name="hours_per_week" class="form-control" value="20"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">¿Cómo nos encontraste? *</label>
                                        <select name="application_source" class="form-select" required="required">
                                            <option value="website">Sitio Web</option>
                                            <option value="workana">Workana</option>
                                            <option value="freelancer">Freelancer.com</option>
                                            <option value="upwork">Upwork</option>
                                            <option value="referral">Referido</option>
                                            <option value="linkedin">LinkedIn</option>
                                            <option value="other">Otro</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">CV / Portfolio (PDF)</label>
                                        <input type="file" name="cv_file" class="form-control" accept=".pdf,.doc,.docx"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Cuéntanos sobre ti</label>
                                        <textarea name="application_notes" class="form-control" rows="4"
                                                  placeholder="Experiencia relevante, proyectos destacados, motivación para unirte..."></textarea>
                                    </div>

                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg">Enviar Aplicación</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Application Success -->
    <template id="collaborator_apply_success" name="Aplicación Enviada">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <div class="card">
                            <div class="card-body py-5">
                                <i class="fa fa-check-circle text-success" style="font-size: 4rem;"></i>
                                <h2 class="mt-4">¡Gracias por tu aplicación!</h2>
                                <p class="text-muted">
                                    Hemos recibido tu información correctamente.
                                    Revisaremos tu perfil y te contactaremos pronto.
                                </p>
                                <a href="/" class="btn btn-primary mt-3">Volver al Inicio</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
