<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="add_collaborator_wizard_form" model="ir.ui.view">
        <field name="name">saas.add.collaborator.wizard.form</field>
        <field name="model">saas.add.collaborator.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar Colaborador">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="skill_filter_ids" widget="many2many_tags"
                           options="{'color_field': 'color'}"/>
                    <field name="collaborator_ids" widget="many2many_tags"/>
                    <field name="send_notification"/>
                </group>
                <footer>
                    <button string="Agregar" type="object" name="action_add_collaborators" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
