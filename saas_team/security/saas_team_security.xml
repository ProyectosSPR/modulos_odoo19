<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- User Group -->
    <record id="group_saas_team_user" model="res.groups">
        <field name="name">SaaS Team / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_saas_team_manager" model="res.groups">
        <field name="name">SaaS Team / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_saas_team_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->

    <!-- Collaborators: Users see all, Managers can edit -->
    <record id="saas_collaborator_rule_user" model="ir.rule">
        <field name="name">Collaborators: User Read</field>
        <field name="model_id" ref="model_saas_collaborator"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_saas_team_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="saas_collaborator_rule_manager" model="ir.rule">
        <field name="name">Collaborators: Manager Full Access</field>
        <field name="model_id" ref="model_saas_collaborator"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_saas_team_manager'))]"/>
    </record>

    <!-- Portal user sees only their own collaborator record -->
    <record id="saas_collaborator_rule_portal" model="ir.rule">
        <field name="name">Collaborators: Portal Own Record</field>
        <field name="model_id" ref="model_saas_collaborator"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Payments: Portal user sees only their payments -->
    <record id="saas_payment_rule_portal" model="ir.rule">
        <field name="name">Payments: Portal Own Payments</field>
        <field name="model_id" ref="model_saas_collaborator_payment"/>
        <field name="domain_force">[('collaborator_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Skills: Everyone can read -->
    <record id="saas_skill_rule_public" model="ir.rule">
        <field name="name">Skills: Public Read</field>
        <field name="model_id" ref="model_saas_skill"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal')), (4, ref('base.group_public'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
