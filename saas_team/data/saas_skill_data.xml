        <record id="seq_collaborator_payment" model="ir.sequence">
            <field name="name">Collaborator Payment</field>
            <field name="code">saas.collaborator.payment</field>
            <field name="prefix">PAY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

