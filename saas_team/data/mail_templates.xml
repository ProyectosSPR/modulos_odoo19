<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Welcome Email for New Collaborator -->
        <record id="email_collaborator_welcome" model="mail.template">
            <field name="name">Colaborador: Bienvenida</field>
            <field name="model_id" ref="model_saas_collaborator"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">¡Bienvenido al equipo de {{ object.company_id.name }}!</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hola <strong>{{ object.name }}</strong>,
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        ¡Bienvenido al equipo de <strong>{{ object.company_id.name }}</strong>!
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Tu cuenta de colaborador ha sido activada. Ahora puedes acceder al portal para:
    </p>
    <ul>
        <li>Ver los proyectos asignados</li>
        <li>Registrar tus horas de trabajo</li>
        <li>Consultar tu balance y pagos</li>
    </ul>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <a href="{{ object.company_id.website }}/my"
           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
            Acceder al Portal
        </a>
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Si tienes alguna pregunta, no dudes en contactarnos.
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Saludos,<br/>
        El equipo de {{ object.company_id.name }}
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Project Shared Email -->
        <record id="email_project_shared" model="mail.template">
            <field name="name">Colaborador: Proyecto Compartido</field>
            <field name="model_id" ref="model_saas_collaborator"/>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Nuevo proyecto asignado: {{ ctx.get('project_name', 'Proyecto') }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hola <strong>{{ object.name }}</strong>,
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Se te ha asignado un nuevo proyecto: <strong>{{ ctx.get('project_name', 'Proyecto') }}</strong>
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Puedes acceder al portal para ver los detalles del proyecto y las tareas asignadas.
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <a href="{{ object.company_id.website }}/my/projects"
           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
            Ver Mis Proyectos
        </a>
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Saludos,<br/>
        El equipo de {{ object.company_id.name }}
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Payment Notification -->
        <record id="email_payment_made" model="mail.template">
            <field name="name">Colaborador: Pago Realizado</field>
            <field name="model_id" ref="model_saas_collaborator_payment"/>
            <field name="email_from">{{ (object.collaborator_id.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.collaborator_id.email }}</field>
            <field name="subject">Pago procesado - {{ object.name }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hola <strong>{{ object.collaborator_id.name }}</strong>,
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Te informamos que se ha procesado tu pago:
    </p>
    <br/>
    <table style="border-collapse: collapse; width: 100%; max-width: 400px;">
        <tr>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Referencia:</strong></td>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Monto:</strong></td>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ object.amount }} {{ object.currency_id.symbol }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Fecha:</strong></td>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ object.date }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Método:</strong></td>
            <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ object.payment_method }}</td>
        </tr>
    </table>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Puedes revisar tu balance actualizado en el portal.
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <a href="{{ object.collaborator_id.company_id.website }}/my/collaborator/balance"
           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
            Ver Mi Balance
        </a>
    </p>
    <br/>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Saludos,<br/>
        El equipo de {{ object.collaborator_id.company_id.name }}
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
