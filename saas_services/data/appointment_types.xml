<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Tipo de cita: Consulta Inicial -->
        <record id="appointment_type_initial_consultation" model="appointment.type">
            <field name="name">Consulta Inicial</field>
            <field name="appointment_duration">1.0</field>
            <field name="appointment_tz">America/Mexico_City</field>
            <field name="category">recurring</field>
            <field name="schedule_based_on">users</field>
            <field name="min_schedule_hours">24</field>
            <field name="max_schedule_days">30</field>
            <field name="auto_confirm">True</field>
            <field name="event_videocall_source">discuss</field>
            <field name="allow_guests">True</field>
        </record>

        <!-- Slots para Consulta Inicial: Lunes a Viernes 9-12 -->
        <record id="slot_initial_mon_am" model="appointment.slot">
            <field name="appointment_type_id" ref="appointment_type_initial_consultation"/>
            <field name="weekday">1</field>
            <field name="start_hour">9</field>
            <field name="end_hour">12</field>
        </record>
        <record id="slot_initial_tue_am" model="appointment.slot">
            <field name="appointment_type_id" ref="appointment_type_initial_consultation"/>
