<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Heredar vista de orden de venta -->
    <record id="sale_order_form_view_saas" model="ir.ui.view">
        <field name="name">sale.order.form.saas.services</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Botón para ver instancias -->
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button name="action_view_saas_instances"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-server"
                        invisible="saas_instance_count == 0">
                    <field name="saas_instance_count" widget="statinfo" string="Instancias"/>
                </button>
            </xpath>

            <!-- Agregar campos de servicio después de la información principal -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="assignment_state" widget="badge"
                       decoration-info="assignment_state == 'pending'"
                       decoration-warning="assignment_state == 'assigned'"
                       decoration-success="assignment_state == 'in_progress'"
                       decoration-primary="assignment_state == 'completed'"
                       invisible="not has_appointment_products"/>
                <field name="assigned_collaborator_id"
                       invisible="not has_appointment_products"/>
            </xpath>

            <!-- Sección de citas -->
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Servicios y Citas" name="services_appointments"
                      invisible="not has_appointment_products">
                    <group>
                        <group string="Cita Programada">
                            <field name="appointment_invite_id" readonly="1"/>
                            <field name="appointment_invite_url" widget="url" readonly="1"/>
                            <button name="action_open_appointment_link"
                                    string="Abrir Link de Cita"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-external-link"
                                    invisible="not appointment_invite_url"/>
                        </group>
                        <group string="Instancias">
                            <field name="saas_instance_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="full_url" widget="url"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Vista de lista con campos adicionales -->
    <record id="sale_order_list_view_saas" model="ir.ui.view">
        <field name="name">sale.order.list.saas.services</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="assignment_state" widget="badge" optional="show"/>
                <field name="assigned_collaborator_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
