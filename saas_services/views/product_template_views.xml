<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Heredar vista de producto para agregar campos de servicio -->
    <record id="product_template_form_view_saas" model="ir.ui.view">
        <field name="name">product.template.form.saas.services</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Configuración SaaS" name="saas_config"
                      invisible="type != 'service'">
                    <group>
                        <group string="Categoría de Servicio">
                            <field name="service_category"/>
                            <field name="requires_quotation"/>
                        </group>
                        <group string="Agendamiento de Citas">
                            <field name="require_appointment"/>
                            <field name="appointment_type_id"
                                   invisible="not require_appointment"/>
                        </group>
                    </group>
                    <group>
                        <group string="Instancia Kubernetes">
                            <field name="creates_k8s_instance"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
